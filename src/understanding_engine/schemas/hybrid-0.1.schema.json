{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cagianoaless/understanding_engine/schemas/hybrid-0.1.0",
  "title": "Hybrid Interface v0 (0.1.0)",
  "type": "object",
  "required": ["hybrid_schema_version", "coordinate_system", "source", "source_canonical_sha256", "association_policy", "hypotheses", "source_only_pages"],
  "additionalProperties": false,
  "properties": {
    "hybrid_schema_version": {"const": "0.1.0"},
    "coordinate_system": {"const": "pdfplumber-native-v1"},
    "source": {"type": "object", "description": "Unmodified extraction 1.0.0, validated separately using the existing source contract"},
    "source_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "association_policy": {"const": "inclusive_original_character_center_v0"},
    "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "source_only_pages": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "box": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "prediction": {
      "type": "object", "required": ["provider", "version", "source_pdf_sha256", "status", "native", "provenance", "error"], "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["docling", "structure_0_2"]},
        "version": {"type": "string", "minLength": 1},
        "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["available", "failed"]},
        "native": {"type": ["object", "null"]},
        "provenance": {"type": "object"},
        "error": {"type": ["string", "null"]}
      }
    },
    "item": {
      "type": "object", "required": ["native_id", "native_pointer", "label", "parent_id", "children_ids", "diagnostic_model_text", "confidence", "region_ids", "geometry_status"], "additionalProperties": false,
      "properties": {
        "native_id": {"type": "string", "minLength": 1},
        "native_pointer": {"type": "string"},
        "label": {"type": "string"},
        "parent_id": {"type": ["string", "null"]},
        "children_ids": {"$ref": "#/$defs/ids"},
        "diagnostic_model_text": {"type": ["string", "null"]},
        "confidence": {"oneOf": [{"type": "null"}, {
          "type": "object", "required": ["value", "native_pointer"], "additionalProperties": false,
          "properties": {"value": {"type": "number"}, "native_pointer": {"type": "string"}}
        }]},
        "region_ids": {"$ref": "#/$defs/ids"},
        "geometry_status": {"enum": ["present", "unavailable"]}
      }
    },
    "region": {
      "type": "object", "required": ["id", "native_item_id", "native_provenance_index", "page_number", "native_bbox", "bbox", "geometric_character_ids", "native_membership", "status"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "native_item_id": {"type": "string"},
        "native_provenance_index": {"type": "integer", "minimum": 0},
        "page_number": {"type": "integer", "minimum": 1},
        "native_bbox": {"type": "object", "required": ["l", "t", "r", "b", "coord_origin"],
          "properties": {"l": {"type": "number"}, "t": {"type": "number"}, "r": {"type": "number"}, "b": {"type": "number"}, "coord_origin": {"enum": ["TOPLEFT", "BOTTOMLEFT"]}}},
        "bbox": {"$ref": "#/$defs/box"},
        "geometric_character_ids": {"$ref": "#/$defs/ids"},
        "native_membership": {"type": "array", "items": {
          "type": "object", "required": ["character_id", "status", "reason"], "additionalProperties": false,
          "properties": {"character_id": {"type": "string"}, "status": {"enum": ["valid", "contradictory"]}, "reason": {"type": ["string", "null"]}}
        }},
        "status": {"enum": ["unambiguous", "ambiguous", "unmatched", "zero_character_visual", "contradictory"]}
      }
    },
    "association": {
      "type": "object", "required": ["page_number", "characters"], "additionalProperties": false,
      "properties": {
        "page_number": {"type": "integer", "minimum": 1},
        "characters": {"type": "array", "items": {
          "type": "object", "required": ["character_id", "geometric_region_ids", "native_region_ids", "contradictory_region_ids", "geometric_status"], "additionalProperties": false,
          "properties": {
            "character_id": {"type": "string"},
            "geometric_region_ids": {"$ref": "#/$defs/ids"},
            "native_region_ids": {"$ref": "#/$defs/ids"},
            "contradictory_region_ids": {"$ref": "#/$defs/ids"},
            "geometric_status": {"enum": ["unambiguous", "ambiguous", "unmatched"]}
          }
        }}
      }
    },
    "hypothesis": {
      "type": "object", "required": ["id", "prediction", "status", "issues", "page_numbers", "items", "regions", "associations", "overlaps", "reading_order"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "prediction": {"$ref": "#/$defs/prediction"},
        "status": {"enum": ["available", "failed", "rejected"]},
        "issues": {"type": "array", "items": {"type": "object", "required": ["code", "detail"], "additionalProperties": false,
          "properties": {"code": {"type": "string"}, "detail": {"type": "string"}}}},
        "page_numbers": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
        "associations": {"type": "array", "items": {"$ref": "#/$defs/association"}},
        "overlaps": {"type": "array", "items": {"type": "object", "required": ["page_number", "region_ids", "meaning"], "additionalProperties": false,
          "properties": {"page_number": {"type": "integer", "minimum": 1}, "region_ids": {"$ref": "#/$defs/ids"}, "meaning": {"const": "positive_area_intersection_not_inferred_hierarchy"}}}},
        "reading_order": {"type": "object", "required": ["kind", "item_ids", "relations", "unresolved_policy"], "additionalProperties": false,
          "properties": {"kind": {"enum": ["item_sequence", "dag", "unavailable"]}, "item_ids": {"$ref": "#/$defs/ids"}, "relations": {"type": "array", "items": {"type": "object"}}, "unresolved_policy": {"type": "string"}}}
      }
    }
  }
}
